# Personal Access Token: https://airtable.com/create/tokens
# Scope: data.records:read — Access: de base "Internship_base"
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Base ID staat in de URL van je base: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Tabelnaam (of tbl-ID) en view. De view-filter (Status = goedgekeurd) wordt door Airtable toegepast.
AIRTABLE_TABLE=Bedrijf stagevoorstel
AIRTABLE_VIEW=Overzicht

# Optioneel: naam van het veld met de bedrijfsnaam (wordt anders automatisch geraden)
# TITLE_FIELD=Bedrijfsnaam

# Optioneel: extra veiligheidsfilter bovenop de view
# STATUS_FIELD=Status
# STATUS_VALUE=Goedgekeurd

PORT=3000
CACHE_SECONDS=300
